rules_version = '2';

// =============================================================================
// SCORPIONS — Regras de segurança do Cloud Firestore
// =============================================================================
//
// PRINCÍPIO: o cliente Flutter não é autoridade sobre nada. A interface pode
// esconder um botão; quem decide se a escrita acontece é este arquivo, avaliado
// no servidor. Toda regra abaixo parte do princípio de que o aplicativo pode
// ter sido adulterado.
//
// LEITURA DESTE ARQUIVO: nada é permitido por padrão. Cada `allow` é uma
// concessão explícita e mínima. A última regra nega tudo que não foi previsto.
//
// LISTA BRANCA, NÃO LISTA NEGRA: onde o cliente escreve, a regra enumera os
// campos que ele PODE gravar. Enumerar os proibidos deixaria passar todo campo
// que ninguém lembrou de proibir.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Auxiliares
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Lê o papel do próprio documento do usuário.
    //
    // CUSTO: cada chamada é uma leitura de documento cobrada. Por isso só é
    // usada nos caminhos administrativos, que são raros. Os caminhos do usuário
    // comum comparam `uid` diretamente, sem `get()`.
    function role() {
      return get(/databases/$(database)/documents/users/$(uid())).data.role;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && role() == 'admin';
    }

    // Conjunto de campos que a escrita está tentando modificar.
    function changedFields() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isOwner(userId) {
      return isSignedIn() && uid() == userId;
    }

    function isValidTimestamp(field) {
      return request.resource.data[field] == request.time;
    }

    // O endereço de e-mail foi confirmado por quem o cadastrou.
    //
    // Exigido para CRIAR conteúdo, não para ler nem apagar: uma conta sem
    // confirmação continua vendo e removendo o que já tem. A claim ausente
    // lança erro de avaliação, e erro de avaliação é recusa.
    function hasVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Dia corrente em UTC, em dias inteiros desde a época.
    function utcDay() {
      return int(math.floor(request.time.toMillis() / 86400000.0));
    }

    // O dia informado pelo cliente é o do servidor, ou um vizinho imediato.
    //
    // A tolerância existe porque quem calcula o dia é o relógio do aparelho, e
    // perto da virada ele pode estar adiantado ou atrasado. Ela não afrouxa o
    // limite: cada dia é um contador próprio, que só enche uma vez. Usar hoje o
    // contador de amanhã gasta a cota de amanhã.
    function isCurrentUsageDay(dia) {
      return dia is string
        && (dia == string(utcDay())
            || dia == string(utcDay() - 1)
            || dia == string(utcDay() + 1));
    }

    // Espelhado em `ImageLimits.maxIdentificationsPerDay` no aplicativo e em
    // `max_analyses_per_day` no backend. Um teste confere que os três batem.
    function dailyCreationLimit() {
      return 60;
    }

    // -------------------------------------------------------------------------
    // users/{userId}
    // -------------------------------------------------------------------------
    // Documento de perfil. A senha NÃO mora aqui — pertence ao Authentication.
    //
    // Contadores (identificationCount, etc.) ficam de fora de propósito: se o
    // cliente pudesse escrevê-los, poderia inflar as próprias estatísticas.
    match /users/{userId} {

      // Registro do aceite do aviso de privacidade.
      //
      // `privacyVersion` diz QUAL texto foi aceito; `consentAt` diz quando. Os
      // dois andam juntos, e o momento é o do servidor — um carimbo vindo do
      // aparelho poderia ser recuado para antes de uma mudança do texto.
      function isValidConsent() {
        let versao = request.resource.data.get('privacyVersion', null);
        return versao == null
          ? !('consentAt' in request.resource.data)
          : (versao is string
             && versao.size() > 0
             && versao.size() <= 32
             && request.resource.data.get('consentAt', null) is timestamp);
      }

      function isValidUserShape() {
        return request.resource.data.keys().hasOnly(
                 ['uid', 'name', 'email', 'role', 'createdAt', 'updatedAt',
                  'privacyVersion', 'consentAt'])
          && request.resource.data.uid is string
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 80
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 320
          && isValidConsent();
      }

      // Um usuário lê o próprio perfil. Admin lê qualquer um.
      allow get: if isOwner(userId) || isAdmin();

      // Listar usuários é operação administrativa: um usuário comum não pode
      // enumerar a base.
      allow list: if isAdmin();

      // O documento é criado pelo próprio dono, com o uid batendo com a sessão.
      //
      // ESCALAÇÃO DE PRIVILÉGIO: `role` é fixado em 'user' pela regra. Mesmo
      // que um cliente adulterado envie `role: 'admin'`, a escrita é recusada.
      // Promover alguém é operação de console ou de backend, nunca do app.
      allow create: if isOwner(userId)
        && isValidUserShape()
        && request.resource.data.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.email == request.auth.token.email
        && isValidTimestamp('createdAt')
        && isValidTimestamp('updatedAt')
        && (!('consentAt' in request.resource.data)
            || isValidTimestamp('consentAt'));

      // O usuário altera o próprio nome e renova o aceite do aviso de
      // privacidade. uid, email, role e createdAt são imutáveis pelo cliente.
      allow update: if isOwner(userId)
        && isValidUserShape()
        && changedFields().hasOnly(
             ['name', 'updatedAt', 'privacyVersion', 'consentAt'])
        && isValidTimestamp('updatedAt')
        && (!changedFields().hasAny(['privacyVersion', 'consentAt'])
            || isValidTimestamp('consentAt'));

      // Exclusão de conta envolve Authentication, Storage e as identificações:
      // precisa de privilégio administrativo e roda no backend (`DELETE
      // /v1/me`), com reautenticação e cascata na ordem segura.
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // users/{userId}/quotas/{dia}
    // -------------------------------------------------------------------------
    // O contador de ANÁLISES, que o backend incrementa numa transação antes de
    // cada pedido de inferência.
    //
    // A regra existe mesmo com a negação final cobrindo o caminho: as regras do
    // Firestore não descem para subcoleções, e depender disso é frágil — basta
    // alguém declarar uma regra recursiva em `users` e o contador fica
    // escrevível. Se o cliente pudesse gravar aqui, zeraria o próprio limite.
    match /users/{userId}/quotas/{dia} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // users/{userId}/usage/{dia}
    // -------------------------------------------------------------------------
    // Quantas identificações a pessoa CRIOU no dia. Diferente de `quotas`, que
    // conta análises e é do backend: este contador é escrito pelo cliente, no
    // mesmo lote da criação, e quem garante que ele só anda para a frente é
    // esta regra.
    //
    // Existe porque a criação acontece direto no Firestore, sem passar pelo
    // backend. Sem ele, uma conta gravava documentos sem limite.
    //
    // `lastId` amarra cada incremento a UMA identificação. Sem essa amarra, um
    // lote com um incremento e quinhentas identificações passaria: todas veriam
    // o contador um acima do anterior.
    match /users/{userId}/usage/{dia} {

      function isValidUsageShape() {
        return request.resource.data.keys().hasOnly(
                 ['count', 'lastId', 'updatedAt'])
          && request.resource.data.keys().hasAll(
                 ['count', 'lastId', 'updatedAt'])
          && request.resource.data.count is int
          && request.resource.data.lastId is string
          && request.resource.data.lastId.size() > 0
          && request.resource.data.lastId.size() <= 64
          && isValidTimestamp('updatedAt');
      }

      allow read: if isOwner(userId) || isAdmin();

      allow create: if isOwner(userId)
        && hasVerifiedEmail()
        && isCurrentUsageDay(dia)
        && isValidUsageShape()
        && request.resource.data.count == 1;

      allow update: if isOwner(userId)
        && hasVerifiedEmail()
        && isCurrentUsageDay(dia)
        && isValidUsageShape()
        && request.resource.data.count == resource.data.count + 1
        && request.resource.data.count <= dailyCreationLimit();

      // Apagar o contador seria zerá-lo.
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // auditLogs/{logId}
    // -------------------------------------------------------------------------
    // Registro de quem fez o quê nas operações críticas.
    //
    // FECHADO PARA TODOS, INCLUSIVE ADMIN — e isso é deliberado. O pior cenário
    // por credencial é uma conta administrativa comprometida, e o audit log é
    // justamente o que registraria essa conta agindo. Deixá-lo alcançável pelo
    // papel que ele audita entregaria ao atacante a capacidade de apagar o
    // próprio rastro.
    //
    // Quem escreve é o backend, com o Admin SDK. Quem lê, numa investigação, é
    // o console do Firebase. Um painel de auditoria no aplicativo, se existir,
    // lê pelo backend, com papel conferido no servidor.
    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // species/{speciesId}
    // -------------------------------------------------------------------------
    // DECISÃO ARQUITETURAL: o catálogo é de LEITURA PÚBLICA.
    //
    // É conteúdo científico de referência, sem dado pessoal, e o produto quer
    // que ele seja consultável inclusive antes do cadastro, quando quem acabou
    // de encontrar um escorpião precisa de informação imediatamente. Escrita é
    // exclusiva de administradores.
    match /species/{speciesId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // identifications/{identificationId}
    // -------------------------------------------------------------------------
    // Registros do usuário. Cada documento pertence a exatamente um `userId`.
    //
    // QUEM ESCREVE O QUÊ
    //
    // O cliente grava o que ele produziu: a fotografia, o que mediu dela e o
    // que foi pedido na captura. Ver `clientCreateFields()`.
    //
    // O servidor grava o que é CONCLUSÃO DE ANÁLISE, com o Admin SDK, que
    // ignora estas regras: speciesId, scientificName, confidence, species,
    // alternatives, rejectionReason, modelVersion, reviewedBy, reviewedAt,
    // humanSpeciesId, isMock, fusion — e `status`, depois da criação.
    //
    // Um valor de confiança forjado pelo cliente contaminaria as métricas,
    // entraria na fila de revisão humana como se fosse saída do modelo e
    // alimentaria o retreinamento com rótulo falso. Por isso nenhum desses
    // campos aparece nas listas abaixo.
    match /identifications/{identificationId} {

      function ownsExisting() {
        return isSignedIn() && resource.data.userId == uid();
      }

      function ownsIncoming() {
        return isSignedIn() && request.resource.data.userId == uid();
      }

      // Tudo que o cliente pode gravar ao criar. Nada além disto.
      function clientCreateFields() {
        return ['userId', 'imageUrl', 'thumbnailUrl', 'status',
                'pipelineVersion', 'imageQuality', 'errorCode', 'createdAt',
                'viewCount', 'secondaryView', 'quotaDay'];
      }

      // O que o cliente pode MUDAR depois: os caminhos das imagens, que só
      // existem quando o envio termina, e a marca de falha de envio.
      function clientUpdateFields() {
        return ['imageUrl', 'thumbnailUrl', 'errorCode', 'secondaryView'];
      }

      // Texto opcional de tamanho limitado.
      //
      // Campos opcionais são lidos com `get(campo, null)`. Acessar direto uma
      // propriedade que não existe lança erro de avaliação em vez de devolver
      // nulo, e a escrita inteira é recusada.
      function isOptionalText(value, max) {
        return value == null || (value is string && value.size() <= max);
      }

      // As medidas de qualidade que o aparelho tirou da fotografia.
      //
      // Forma fechada: sem isto o mapa viraria um depósito de dados arbitrários
      // dentro de um documento que o dono escreve à vontade.
      function isValidQuality(q) {
        return q == null || (
          q is map
          && q.keys().hasOnly(['quality', 'score', 'brightness', 'contrast',
                               'sharpness', 'width', 'height', 'warnings'])
          && q.get('quality', '') is string
          && q.get('quality', '').size() <= 16
          && q.get('score', 0) is number
          && q.get('brightness', 0) is number
          && q.get('contrast', 0) is number
          && q.get('sharpness', 0) is number
          && q.get('width', 0) is int
          && q.get('height', 0) is int
          && q.get('warnings', []) is list
          && q.get('warnings', []).hasOnly(
               ['tooDark', 'tooBright', 'lowContrast', 'blurry', 'softFocus',
                'lowResolution'])
        );
      }

      // A segunda fotografia da identificação. É dado do cliente — ele
      // capturou, mediu e enviou. O que as duas fotos disseram JUNTAS vai em
      // `fusion`, que só o servidor escreve.
      function isValidSecondaryView(v) {
        return v == null || (
          v is map
          && v.keys().hasOnly(['captureType', 'instructionId', 'imageUrl',
                               'thumbnailUrl', 'imageQuality'])
          && v.get('captureType', '') is string
          && v.get('captureType', '').size() <= 32
          && v.get('instructionId', '') is string
          && v.get('instructionId', '').size() <= 64
          && isOptionalText(v.get('imageUrl', null), 512)
          && isOptionalText(v.get('thumbnailUrl', null), 512)
          && isValidQuality(v.get('imageQuality', null))
        );
      }

      function isValidClientFields() {
        let d = request.resource.data;
        let vistas = d.get('viewCount', null);

        return isOptionalText(d.get('imageUrl', null), 512)
          && isOptionalText(d.get('thumbnailUrl', null), 512)
          && isOptionalText(d.get('pipelineVersion', null), 64)
          && isOptionalText(d.get('errorCode', null), 64)
          && isValidQuality(d.get('imageQuality', null))
          // Uma ou duas fotografias. O backend recusa a terceira, e a regra do
          // Storage não aceita nome de arquivo para ela.
          && (vistas == null || vistas == 1 || vistas == 2)
          && isValidSecondaryView(d.get('secondaryView', null));
      }

      // O contador do dia subiu exatamente um, e subiu POR ESTA identificação.
      //
      // `getAfter` enxerga o estado depois do lote inteiro. Comparado com o
      // estado de antes, prova que o incremento veio junto — e `lastId` prova
      // que veio para este documento, e não para outro do mesmo lote.
      function usageWasCharged(dia) {
        let caminho =
          /databases/$(database)/documents/users/$(uid())/usage/$(dia);
        return getAfter(caminho).data.lastId == identificationId
          && getAfter(caminho).data.count ==
               (exists(caminho) ? get(caminho).data.count + 1 : 1);
      }

      // A criação nasce sempre em `processing`. Os outros estados são
      // conclusões de uma análise, e a análise não acontece no aplicativo.
      function isValidCreation() {
        let dia = request.resource.data.get('quotaDay', null);

        return request.resource.data.keys().hasOnly(clientCreateFields())
          && request.resource.data.userId is string
          && request.resource.data.status == 'processing'
          && isValidTimestamp('createdAt')
          && isValidClientFields()
          && isCurrentUsageDay(dia)
          && usageWasCharged(dia);
      }

      // Leitura e listagem exigem que o documento seja do solicitante. Uma
      // consulta sem `where('userId', '==', uid)` é recusada: o Firestore só
      // autoriza uma listagem quando consegue provar que TODO resultado
      // possível satisfaz a regra.
      allow read: if ownsExisting() || isAdmin();

      allow create: if ownsIncoming()
        && hasVerifiedEmail()
        && isValidCreation();

      // O segundo passo normal do pipeline: o documento nasce sem imagem e
      // recebe os caminhos quando o envio termina.
      //
      // `changedFields().hasOnly(...)` é o que fecha o resto. Dono, data de
      // criação, estado, dia da cota e todo campo do servidor ficam imutáveis
      // para o cliente sem precisar ser citados um a um — inclusive os que
      // ainda não existem.
      allow update: if ownsExisting()
        && ownsIncoming()
        && changedFields().hasOnly(clientUpdateFields())
        && isValidClientFields();

      // O usuário pode apagar o próprio registro. O arquivo no Storage é
      // removido pelo aplicativo em seguida.
      allow delete: if ownsExisting();
    }

    // -------------------------------------------------------------------------
    // feedback/{feedbackId}
    // -------------------------------------------------------------------------
    // Fechada até a funcionalidade existir.
    //
    // Havia aqui uma regra de criação aberta — qualquer conta gravava um
    // documento de forma livre — para uma tela que ainda não foi escrita. Regra
    // sem uso é superfície sem benefício. Quando o retorno do usuário sobre o
    // resultado for implementado, a regra nasce junto, com forma fechada e
    // teste.
    match /feedback/{feedbackId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Negação final
    // -------------------------------------------------------------------------
    // Qualquer coleção não declarada acima é inacessível. Criar uma coleção
    // nova exige escrever a regra dela: nada nasce aberto por esquecimento.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
