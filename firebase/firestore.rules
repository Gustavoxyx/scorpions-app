rules_version = '2';

// =============================================================================
// SCORPIONS — Regras de segurança do Cloud Firestore
// =============================================================================
//
// PRINCÍPIO (brief §7, §38): o cliente Flutter não é autoridade sobre nada.
// A interface pode esconder um botão; quem decide se a escrita acontece é este
// arquivo, avaliado no servidor. Toda regra abaixo parte do princípio de que o
// aplicativo pode ter sido adulterado.
//
// LEITURA DESTE ARQUIVO: nada é permitido por padrão. Cada `allow` é uma
// concessão explícita e mínima. A última regra nega tudo que não foi previsto.
// =============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Auxiliares
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Lê o papel do próprio documento do usuário.
    //
    // CUSTO: cada chamada é uma leitura de documento cobrada. Por isso só é
    // usada nos caminhos administrativos, que são raros. Os caminhos do usuário
    // comum comparam `uid` diretamente, sem `get()`.
    function role() {
      return get(/databases/$(database)/documents/users/$(uid())).data.role;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(uid()))
        && role() == 'admin';
    }

    // Conjunto de campos que a escrita está tentando modificar.
    function changedFields() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isOwner(userId) {
      return isSignedIn() && uid() == userId;
    }

    function isValidTimestamp(field) {
      return request.resource.data[field] == request.time;
    }

    // -------------------------------------------------------------------------
    // users/{userId}  (brief §9)
    // -------------------------------------------------------------------------
    // Documento de perfil. A senha NÃO mora aqui — pertence ao Authentication.
    //
    // Campos: uid, name, email, role, createdAt, updatedAt.
    //
    // Contadores (identificationCount, etc.) foram deliberadamente deixados de
    // fora: se o cliente pudesse escrevê-los, poderia inflar as próprias
    // estatísticas. O perfil deriva os números da coleção de identificações.
    // Quando a escala exigir denormalização, ela virá de uma Cloud Function.
    match /users/{userId} {

      function isValidUserShape() {
        return request.resource.data.keys().hasOnly(
                 ['uid', 'name', 'email', 'role', 'createdAt', 'updatedAt'])
          && request.resource.data.uid is string
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2
          && request.resource.data.name.size() <= 80
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 320;
      }

      // Um usuário lê o próprio perfil. Admin lê qualquer um.
      allow get: if isOwner(userId) || isAdmin();

      // Listar usuários é operação administrativa: um usuário comum não pode
      // enumerar a base.
      allow list: if isAdmin();

      // O documento é criado pelo próprio dono, com o uid batendo com a sessão.
      //
      // ESCALAÇÃO DE PRIVILÉGIO: `role` é fixado em 'user' pela regra. Mesmo
      // que um cliente adulterado envie `role: 'admin'`, a escrita é recusada.
      // Promover alguém a admin é operação de console/backend, nunca do app.
      allow create: if isOwner(userId)
        && isValidUserShape()
        && request.resource.data.uid == userId
        && request.resource.data.role == 'user'
        && request.resource.data.email == request.auth.token.email
        && isValidTimestamp('createdAt')
        && isValidTimestamp('updatedAt');

      // O usuário só altera o próprio nome. uid, email, role e createdAt são
      // imutáveis a partir do cliente.
      allow update: if isOwner(userId)
        && isValidUserShape()
        && changedFields().hasOnly(['name', 'updatedAt'])
        && isValidTimestamp('updatedAt');

      // Exclusão de conta (§37) envolve Authentication, Storage e as
      // identificações — precisa de privilégio administrativo e roda em
      // backend. Nunca a partir do aplicativo.
      //
      // Existe agora: `DELETE /v1/me` no backend de inferência, com
      // reautenticação exigida e cascata na ordem segura. Fecha o HIGH-2 da
      // auditoria e o Art. 18, VI da LGPD. A regra continua `false` porque o
      // caminho é o backend, com o Admin SDK — não o cliente.
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // users/{userId}/quotas/{dia}  (MEDIUM-4 da auditoria)
    // -------------------------------------------------------------------------
    // O contador de uso diário, que o backend incrementa numa transação antes
    // de cada análise.
    //
    // POR QUE A REGRA PRECISA EXISTIR, SE A NEGAÇÃO FINAL JÁ COBRE
    // As regras do Firestore **não** descem para subcoleções: `users/{userId}`
    // não alcança `users/{userId}/quotas/{dia}`, e o `match /{document=**}` do
    // fim já negaria tudo aqui. Mas depender disso é frágil — basta alguém
    // declarar uma regra recursiva em `users` e o contador fica escrevível.
    //
    // E escrevível é o que não pode ser. Se o cliente pudesse gravar aqui, ele
    // zeraria o próprio contador e o limite de uso deixaria de existir — o
    // MEDIUM-4 voltaria por uma porta diferente da que foi fechada.
    //
    // Então: leitura para o dono (a tela pode mostrar quanto resta, e
    // `GET /v1/me/quota` existe para o caso autoritativo), escrita para
    // **ninguém**.
    match /users/{userId}/quotas/{dia} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // auditLogs/{logId}  (LOW-4 da auditoria, FASE 24 do briefing)
    // -------------------------------------------------------------------------
    // Registro de quem fez o quê nas operações críticas.
    //
    // FECHADO PARA TODOS, INCLUSIVE ADMIN — e isso é deliberado.
    //
    // O modelo de ameaças marca em T-4 que o pior cenário por credencial é uma
    // conta administrativa comprometida. O audit log é justamente o que
    // registraria essa conta agindo. Deixá-lo alcançável pelo papel que ele
    // audita entregaria ao atacante a capacidade de apagar o próprio rastro — e
    // o plano de resposta a incidentes tem uma regra que não se quebra: não
    // apagar evidência.
    //
    // Quem escreve é o backend, com o Admin SDK, que ignora estas regras. Quem
    // lê, numa investigação, é o console do Firebase — onde o acesso é do dono
    // do projeto e fica registrado pelo Google.
    //
    // Se um dia houver um painel de auditoria no aplicativo, ele lê pelo
    // backend, com papel conferido no servidor. Não daqui.
    match /auditLogs/{logId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // species/{speciesId}  (brief §10)
    // -------------------------------------------------------------------------
    // DECISÃO ARQUITETURAL: o catálogo é de LEITURA PÚBLICA.
    //
    // É conteúdo científico de referência, sem dado pessoal, e o produto quer
    // que ele seja consultável — inclusive antes do cadastro, quando quem
    // acabou de encontrar um escorpião precisa de informação imediatamente.
    // Escrita é exclusiva de administradores.
    match /species/{speciesId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // identifications/{identificationId}  (brief §11, §28)
    // -------------------------------------------------------------------------
    // Registros do usuário. Cada documento pertence a exatamente um `userId`.
    match /identifications/{identificationId} {

      function ownsExisting() {
        return isSignedIn() && resource.data.userId == uid();
      }

      function ownsIncoming() {
        return isSignedIn() && request.resource.data.userId == uid();
      }

      function isValidStatus(value) {
        return value in ['processing', 'identified', 'low_confidence',
                         'rejected', 'error'];
      }

      // Campos do pipeline de imagem (Fase 4, §10).
      //
      // São conferidos aqui porque o cliente os escreve, e um cliente adulterado
      // escreveria qualquer coisa. `imageQuality` é o caso mais delicado: é um
      // mapa aberto, e sem limite de tamanho viraria um depósito de dados
      // arbitrários dentro de um documento que o dono pode escrever à vontade.
      //
      // ATENÇÃO ao uso de `get(campo, padrão)`. Escrever
      // `request.resource.data.thumbnailUrl == null` **não** funciona: acessar
      // uma propriedade que não existe no mapa lança erro de avaliação em vez
      // de devolver nulo, e a escrita inteira é recusada. Foi assim que a
      // primeira versão desta função quebrou a criação de identificações — o
      // emulador apontou "Property thumbnailUrl is undefined on object".
      //
      // Campos opcionais precisam ser lidos com valor padrão, sempre.
      function isValidPipelineFields() {
        let d = request.resource.data;
        let thumb = d.get('thumbnailUrl', null);
        let versao = d.get('pipelineVersion', null);
        let erro = d.get('errorCode', null);
        let qualidade = d.get('imageQuality', null);
        let vistas = d.get('viewCount', null);

        return (thumb == null || (thumb is string && thumb.size() <= 512))
          && (versao == null || (versao is string && versao.size() <= 64))
          && (erro == null || (erro is string && erro.size() <= 64))
          && (qualidade == null
              || (qualidade is map && qualidade.keys().size() <= 12))
          // Uma ou duas fotografias. O backend recusa a terceira, e a regra do
          // Storage não aceita nome de arquivo para ela.
          && (vistas == null || vistas == 1 || vistas == 2)
          && isValidSecondaryView();
      }

      // A segunda fotografia da identificação (Fase 5).
      //
      // É dado do CLIENTE — ele capturou, mediu e enviou — e por isso é
      // validado como os outros campos do pipeline: forma fechada e tamanhos
      // limitados.
      //
      // `hasOnly` é o que importa aqui. Sem ele o mapa seria aberto, e um
      // cliente adulterado guardaria ali `confidence: 0.99` ou qualquer outra
      // conclusão de análise, um nível abaixo de onde `serverOwnedFields()`
      // olha. O que as duas fotos disseram juntas vai em `fusion`, que só o
      // servidor escreve.
      function isValidSecondaryView() {
        let v = request.resource.data.get('secondaryView', null);

        return v == null || (
          v is map
          && v.keys().hasOnly(['captureType', 'instructionId', 'imageUrl',
                               'thumbnailUrl', 'imageQuality'])
          && v.get('captureType', '') is string
          && v.get('captureType', '').size() <= 32
          && v.get('instructionId', '') is string
          && v.get('instructionId', '').size() <= 64
          && (v.get('imageUrl', null) == null
              || (v.get('imageUrl', null) is string
                  && v.get('imageUrl', null).size() <= 512))
          && (v.get('thumbnailUrl', null) == null
              || (v.get('thumbnailUrl', null) is string
                  && v.get('thumbnailUrl', null).size() <= 512))
          && (v.get('imageQuality', null) == null
              || (v.get('imageQuality', null) is map
                  && v.get('imageQuality', null).keys().size() <= 12))
        );
      }

      // Campos que SÓ O SERVIDOR escreve (auditoria HIGH-1).
      //
      // Até aqui, a regra validava o FORMATO de `confidence` — entre 0 e 1 —
      // e deixava passar qualquer valor nesse intervalo. Formato não é
      // origem: um `0.99` forjado por um cliente adulterado passava
      // exatamente como um produzido por um modelo.
      //
      // Sem IA, o estrago era pequeno: o usuário poluía o próprio histórico.
      // Com IA, um registro forjado contamina as métricas de acurácia, entra
      // na fila de revisão humana como se fosse saída do modelo, alimenta o
      // dataset de retreinamento com rótulo falso, e destrói a
      // auditabilidade — não haveria como distinguir o que o modelo disse do
      // que o usuário digitou.
      //
      // O backend de inferência escreve estes campos com o Admin SDK, que
      // ignora as regras por natureza. Então proibi-los aqui não atrapalha o
      // servidor e fecha o cliente.
      function serverOwnedFields() {
        // `fusion` é o que a análise concluiu sobre o CONJUNTO das vistas:
        // se concordaram, quanto, e qual foi a decisão. Forjar "as duas fotos
        // concordaram" é o mesmo ataque de forjar `confidence: 0.99`, por
        // outro campo.
        return ['speciesId', 'scientificName', 'confidence', 'species',
                'alternatives', 'rejectionReason', 'modelVersion',
                'reviewedBy', 'reviewedAt', 'humanSpeciesId', 'isMock',
                'fusion'];
      }

      // A criação nasce sempre em `processing`.
      //
      // Os outros estados são CONCLUSÕES de uma análise, e a análise não
      // acontece no aplicativo. Permitir que o cliente criasse um documento
      // já `identified` seria o mesmo furo por outro caminho.
      function isValidIdentification() {
        return request.resource.data.userId is string
          && request.resource.data.status == 'processing'
          && !request.resource.data.keys().hasAny(serverOwnedFields())
          && isValidPipelineFields()
          && isValidTimestamp('createdAt');
      }

      // Leitura e listagem exigem que o documento seja do solicitante.
      //
      // Isto também resolve o §28 sem código: uma consulta sem
      // `where('userId', '==', uid)` é recusada pelo servidor, porque o
      // Firestore só autoriza uma listagem quando consegue provar que TODO
      // resultado possível satisfaz a regra. Não há como buscar o histórico
      // alheio, nem por engano.
      allow read: if ownsExisting() || isAdmin();

      allow create: if ownsIncoming() && isValidIdentification();

      // Atualização mantém a posse e não permite transferir o registro para
      // outro usuário.
      // A atualização é o segundo passo normal do pipeline: o documento nasce
      // sem imagem e recebe os caminhos quando o envio termina.
      // O cliente atualiza só o que ele produziu: os caminhos das imagens e a
      // marca de falha de envio. `changedFields()` é o que torna isso
      // verificável — ele lista o que a escrita está MUDANDO, então um
      // documento já analisado pelo servidor não pode ter o resultado
      // reescrito por quem o criou.
      allow update: if ownsExisting()
        && ownsIncoming()
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.createdAt == resource.data.createdAt
        && !changedFields().hasAny(serverOwnedFields())
        && isValidStatus(request.resource.data.status)
        && isValidPipelineFields();

      // O usuário pode apagar o próprio registro (§36 — controle sobre os
      // próprios dados). O arquivo no Storage é removido pelo aplicativo em
      // seguida; a limpeza de órfãos fica para uma Function.
      allow delete: if ownsExisting();
    }

    // -------------------------------------------------------------------------
    // feedback/{feedbackId}  (Fase 8 — human-in-the-loop)
    // -------------------------------------------------------------------------
    // Criado agora apenas com a regra segura. Sem uso no aplicativo ainda.
    match /feedback/{feedbackId} {
      allow create: if isSignedIn()
        && request.resource.data.userId == uid()
        && isValidTimestamp('createdAt');
      allow read: if (isSignedIn() && resource.data.userId == uid()) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // Negação final
    // -------------------------------------------------------------------------
    // Qualquer coleção não declarada acima é inacessível. Criar uma coleção
    // nova exige escrever a regra dela — que é exatamente o comportamento
    // desejado: nada nasce aberto por esquecimento.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
