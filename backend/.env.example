# Copie para `.env` e preencha. O `.env` está no .gitignore e NUNCA é commitado.
#
# A service account IGNORA as Security Rules. Se vazar, entrega o banco
# inteiro. Ela existe só no servidor — nunca no aplicativo Flutter.
#
# Para obter: console do Firebase > Configurações do projeto > Contas de
# serviço > Gerar nova chave privada. O arquivo baixado é o JSON abaixo.
#
# Em produção, cole o MESMO conteúdo nos secrets do provedor (Hugging Face
# Space: Settings > Variables and secrets; Render: Environment).

FIREBASE_PROJECT_ID=scorpions-tcc-2026
FIREBASE_STORAGE_BUCKET=scorpions-tcc-2026.firebasestorage.app

# JSON em uma linha, ou o mesmo JSON em base64 — alguns provedores estragam
# quebras de linha, e a chave privada tem várias.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Origens autorizadas, separadas por vírgula. Nunca `*`.
ALLOWED_ORIGINS=http://localhost:8099

MAX_ANALYSES_PER_DAY=60

# Exigir o token do App Check em toda chamada de /v1. Deixe sem definir até o
# provedor estar registrado no console e a versão do aplicativo que envia o
# token estar publicada — ligado antes disso, barra o próprio aplicativo.
# REQUIRE_APP_CHECK=1

# Exigir verificação em duas etapas de quem tem papel privilegiado. Só depois de
# o MFA estar habilitado no projeto e configurado nessas contas.
# REQUIRE_MFA_FOR_STAFF=1
