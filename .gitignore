# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# O Gradle também escreve aqui. `android/build.gradle.kts` redireciona a saída
# principal para `/build/`, mas os relatórios de problemas do Gradle 9 continuam
# caindo em `android/build/reports/` — artefato de build, nunca versionado.
/android/build/
/android/.gradle/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Firebase
firebase/node_modules/
firebase/test/contract-shapes.json
*-debug.log
firestore-debug.log
firebase-debug.log
ui-debug.log
.firebase/

# Credenciais — nunca versionar (brief §32)
**/serviceAccount*.json
**/*-firebase-adminsdk-*.json
google-services.json
GoogleService-Info.plist

# Backend de inferência
backend/.venv/
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/.pytest_cache/
backend/.env
backend/*.egg-info/
# Casos de paridade: GERADOS pelo teste Dart, nunca editados à mão.
backend/tests/fusion_cases.json
# Artefatos de modelo: pesados e versionados fora do Git.
backend/models/*.pt
backend/models/*.onnx
backend/models/*.tflite
